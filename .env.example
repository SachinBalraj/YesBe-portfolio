# ─── Google Tag Manager ───
# Installed via official snippet in index.html (container: GTM-PZ9KWVFH)
# GA4 is configured inside the GTM container — no env var needed for analytics.

# EmailJS Configuration
# Replace with your actual EmailJS credentials from https://www.emailjs.com
VITE_EMAILJS_SERVICE_ID=service_default
VITE_EMAILJS_ENQUIRY_TEMPLATE_ID=template_enquiry
VITE_EMAILJS_PUBLIC_KEY=

# ─── Backend: MongoDB Atlas + Admin access (server-side only) ───
# These are read by the Vercel serverless functions in /api.
# Set them in the Vercel project dashboard (Environment Variables),
# NOT in a VITE_ prefixed variable — VITE_ vars are exposed to the browser.

# MongoDB Atlas connection string. Use a least-privilege user that can only
# read/write the YesBe database.
MONGODB_URI=
# Optional, defaults to "yesbe"
MONGODB_DB_NAME=yesbe

# Admin login for /admin
ADMIN_EMAIL=hello@yesbe.tech
# Preferred: scrypt hash. Generate with:
#   node --experimental-strip-types -e "import('./api/_lib/auth.ts').then(async m=>console.log(await m.createPasswordHash('yourpassword')))"
# Fallback if unset: ADMIN_PASSWORD (plaintext, less safe)
ADMIN_PASSWORD_HASH=

# At least 32 random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=
