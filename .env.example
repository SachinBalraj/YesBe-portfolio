# ─── Google Analytics 4 ───
# Get your GA4 Measurement ID from https://analytics.google.com
# Admin → Data Streams → your web stream → Measurement ID
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Google Tag Manager ───
# Get your GTM Container ID from https://tagmanager.google.com
# Admin → Container → Install Google Tag Manager
# VITE_GTM_ID=GTM-XXXXXXXXXX

# EmailJS Configuration
# Replace with your actual EmailJS credentials from https://www.emailjs.com
VITE_EMAILJS_SERVICE_ID=service_default
VITE_EMAILJS_ENQUIRY_TEMPLATE_ID=template_enquiry
VITE_EMAILJS_PUBLIC_KEY=
